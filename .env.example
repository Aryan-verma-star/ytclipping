# YouTube Clipper — environment variables
# Copy to backend/.env for local runs, or set in your host's dashboard.
#
# NOTE the CLIPPER_ prefix: it prevents collisions with platform-injected
# variables (e.g. Render's own DATABASE_URL) in shared environments.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | production
CLIPPER_ENVIRONMENT=development
CLIPPER_LOG_LEVEL=INFO

# Cross-Origin Resource Sharing — ONLY for split deployments where the
# frontend lives on a different domain than the backend (e.g. frontend on
# Vercel + backend on Render). Comma-separated origins, no trailing slashes:
#   CLIPPER_ALLOWED_ORIGINS=https://youtube-clipper.vercel.app
# Empty (default) = same-origin only; the API then sends no CORS headers.
# The frontend side of this setting is window.CLIPPER_API_BASE in
# frontend/index.html.
CLIPPER_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Persistence (REQUIRED for production)
# ---------------------------------------------------------------------------
# SQLite (local dev default): leave empty — uses backend/data/clips.db
# Neon / any Postgres: postgresql://user:password@host/dbname?sslmode=require
CLIPPER_DATABASE_URL=

# Where clip files + temp downloads live (default: backend/data).
# On Render's ephemeral disk the Dockerfile sets this to /data.
CLIPPER_DATA_DIR=

# Directory of the static frontend (default: ../frontend relative to backend/)
CLIPPER_FRONTEND_DIR=

# Set false to skip schema init at boot (e.g. run `alembic upgrade head` yourself)
CLIPPER_INIT_DB_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Validation limits
# ---------------------------------------------------------------------------
# Maximum clip length in seconds (user decision: 10 minutes)
CLIPPER_MAX_CLIP_SECONDS=600
# Maximum source video length in seconds (user decision: 4 hours)
CLIPPER_MAX_SOURCE_SECONDS=14400

# ---------------------------------------------------------------------------
# Downloader providers (spec §5) — ordered fallback chain
# ---------------------------------------------------------------------------
# Comma-separated chain, tried left to right until one succeeds:
#   vidssave — reverse-engineered vidssave.com resolver: their servers do the
#              YouTube resolution and return CDN links that are NOT IP-locked,
#              so it works even from datacenter IPs (Render) [primary]
#   cobalt   — third-party download API (see below)
#   ytdlp    — locally-run yt-dlp binary [fallback; needs cookies on datacenter IPs]
#   sample   — DEV/TEST ONLY: synthesizes a local video, never downloads
CLIPPER_DOWNLOADER_PROVIDERS=vidssave,cobalt,ytdlp

# --- vidssave provider (server engine path; the browser engine uses it too,
#     but directly from the user's IP — see frontend/js/vidssave-client.js) ---
# Kill switch if the site changes/breaks:
CLIPPER_VIDSSAVE_ENABLED=true
# Optional API override (self-hosted mirror / future host change). Empty =
# auto: production API first, their staging endpoint as datacenter fallback.
CLIPPER_VIDSSAVE_API_URL=
# Per-HTTP-call timeout (seconds)
CLIPPER_VIDSSAVE_TIMEOUT_SECONDS=30
# Muxing-task budget — vidssave prepares the file server-side (seconds)
CLIPPER_VIDSSAVE_TASK_TIMEOUT_SECONDS=600
# EXTRA hosts the /api/media/proxy endpoint may relay to — TESTING ONLY
# (sandbox e2e). Leave EMPTY in production; vidssave hosts are always allowed.
CLIPPER_MEDIA_PROXY_EXTRA_HOSTS=

# --- cobalt provider (no URLs are hardcoded; bring your own instance) ---
# Base URL of a cobalt-compatible API instance, e.g. your self-hosted one
# or a community instance you trust. VERIFIED 2026-10-03: the official
# api.cobalt.tools now rejects anonymous requests (JWT auth required).
CLIPPER_COBALT_API_URL=
# Optional bearer token if your instance requires authentication
CLIPPER_COBALT_API_KEY=
# Timeout for the API request itself (seconds)
CLIPPER_COBALT_TIMEOUT_SECONDS=30

# --- yt-dlp provider ---
# Timeout for one yt-dlp invocation (seconds)
CLIPPER_YTDLP_TIMEOUT_SECONDS=900
# Optional cookies.txt export — REQUIRED on datacenter IPs (Render etc.),
# where YouTube bot-checks anonymous downloads. Not needed on residential IPs.
CLIPPER_YTDLP_COOKIES_FILE=
# ALTERNATIVE to the file path: paste the raw cookies.txt CONTENT here
# (the app writes it to a private temp file at startup). Easiest option
# on Render — Environment → add CLIPPER_YTDLP_COOKIES, paste, save.
CLIPPER_YTDLP_COOKIES=
# Extra CLI args, space separated (advanced)
CLIPPER_YTDLP_EXTRA_ARGS=

# --- shared ---
# Cap on the video resolution fetched (lowest-sufficient-quality policy)
CLIPPER_MAX_VIDEO_HEIGHT=720
# Hard cap on a single source download in bytes (default ~1.5 GB)
CLIPPER_MAX_DOWNLOAD_BYTES=1500000000
# Cap on the dev/test sample provider's synthesized duration
CLIPPER_SAMPLE_MAX_SECONDS=120

# ---------------------------------------------------------------------------
# Retention (spec §7): files are deleted, metadata records are kept forever
# ---------------------------------------------------------------------------
CLIPPER_CLIP_RETENTION_HOURS=24
CLIPPER_RETENTION_SWEEP_INTERVAL_SECONDS=900

# ---------------------------------------------------------------------------
# Preview pipeline (timeline UI)
# ---------------------------------------------------------------------------
# Filmstrip tiles generated per preview (evenly spaced across the source)
CLIPPER_PREVIEW_THUMB_COUNT=60
# Tile height in pixels (width follows the video's aspect ratio)
CLIPPER_PREVIEW_THUMB_HEIGHT=120
# Preview files (downloaded source + thumbnails) swept after this many hours
CLIPPER_PREVIEW_RETENTION_HOURS=24
# Hard wall for a stuck preview download/thumbnail generation, in minutes
CLIPPER_PREVIEW_MAX_PROCESSING_MINUTES=30

# ---------------------------------------------------------------------------
# Job worker
# ---------------------------------------------------------------------------
CLIPPER_WORKER_ENABLED=true
CLIPPER_WORKER_POLL_INTERVAL_SECONDS=1

# ---------------------------------------------------------------------------
# Abuse protection (spec §10)
# ---------------------------------------------------------------------------
# General API requests per client IP per minute
CLIPPER_RATE_LIMIT_PER_MINUTE=60
# Job creations per client IP per minute
CLIPPER_RATE_LIMIT_JOBS_PER_MINUTE=6
# Preview creations per client IP per minute (each one is a FULL source download)
CLIPPER_RATE_LIMIT_PREVIEWS_PER_MINUTE=6
# Maximum accepted request body size in bytes (URL submissions are tiny).
# NOTE: POST /api/uploads is exempt from this cap — it enforces its own
# CLIPPER_MAX_UPLOAD_BYTES limit while streaming multipart bodies to disk.
CLIPPER_MAX_REQUEST_BYTES=65536

# ---------------------------------------------------------------------------
# File uploads (clip your OWN videos without a YouTube URL)
# ---------------------------------------------------------------------------
# Hard cap for one uploaded source file, in bytes (default 400 MB — same as
# the browser engine's wasm limit). Raise on roomier instances if needed.
CLIPPER_MAX_UPLOAD_BYTES=400000000
# Uploaded sources are transient (they only feed clip jobs) — bin + sidecar
# metadata are swept together after this window.
CLIPPER_UPLOAD_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# Phase 4 (AI) — extension point, intentionally not implemented
# ---------------------------------------------------------------------------
CLIPPER_AI_ANALYZER_ENABLED=false
