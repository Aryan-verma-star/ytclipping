          "previews"
        ],
        "summary": "Create Preview",
        "description": "Queue a source-video preview (instant stream + background download).\n\nThe frontend polls GET /api/previews/{id} and renders the player +\ntimeline as soon as ``video_url``/``duration`` appear. Asking again for\nthe same URL returns the existing usable preview (ready or in-flight)\ninstead of starting a second download.",
        "operationId": "create_preview_api_previews_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePreviewRequest"
