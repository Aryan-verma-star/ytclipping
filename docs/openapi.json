      "get": {
        "tags": [
          "previews"
        ],
        "summary": "Preview Stream",
        "description": "The preview's single playback URL for its entire lifetime.\n\n- Local file on disk (processing/ready) \u2192 served directly; FileResponse\n  handles Range requests (video seeking).\n- Still streaming from the provider \u2192 the stored, provider-resolved URL\n  is proxied with the browser's Range header forwarded so the <video>\n  element can seek before the download finishes.",
        "operationId": "preview_stream_api_previews__preview_id__stream_get",
        "parameters": [
          {
            "name": "preview_id",
